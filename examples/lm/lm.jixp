; a tiny GPT-shaped language model: token ids (batch, seq) -> logits
; (rotary position embeddings inside attention; examples/gpt uses a
;  learned pos-embedding instead)
(let-dim
  (vocab 256)
  (d 128)
  (heads 8)
  (layers 4))

(define block (chain
  (residual (rmsnorm d)
            (attention d heads #:causal #:rope))
  (residual (rmsnorm d)
            (mlp d [4d] d #:activation relu2))))

(define lm (chain
  (embedding vocab d)
  (repeat layers block)
  (rmsnorm d)
  (mlp d [] vocab)))
