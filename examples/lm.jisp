; a tiny GPT-shaped language model: token ids (batch, seq) -> logits
; (no positional encoding yet — rope is on the roadmap)
(let-dim
  (vocab 256)
  (d 128)
  (heads 8)
  (layers 4))

(define block (chain
  (residual (layernorm d)
            (attention d heads #:causal))
  (residual (layernorm d)
            (mlp d [4d] d))))

(define lm (chain
  (embedding vocab d)
  (repeat layers block)
  (layernorm d)
  (mlp d [] vocab)))
