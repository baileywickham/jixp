; a pre-norm decoder stack: (batch, seq, d) -> (batch, seq, d)
(let-dim
  (d 128)
  (heads 8)
  (layers 4))

(define attn-block (residual (chain (layernorm d) (attention d heads #:causal))))
(define
  ffn-block
  (residual (chain (layernorm d) (mlp d [4d] d))))

(define encoder (repeat layers (chain attn-block ffn-block)))
